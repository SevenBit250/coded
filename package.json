{
  "name": "coded",
  "productName": "Coded",
  "version": "0.1.0",
  "description": "Coded — an agent desktop shell (Electron): frameless window, frosted-glass startup, pluggable agent backends over the CodedBridge protocol.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coded/bridge-protocol": "*",
    "@tanstack/vue-virtual": "^3.13.36",
    "electron-log": "^5.4.4",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.11"
  }
}
